{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check branch and changes",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check upstream tracking",
			"type": "shell",
			"command": "git",
			"args": [
				"branch",
				"-vv"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git staged summary review",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"diff",
				"--cached",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review upstream branch",
			"type": "shell",
			"command": "git",
			"args": [
				"rev-parse",
				"--abbrev-ref",
				"--symbolic-full-name",
				"@{u}"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review remaining diff summary",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"diff",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Interactively stage selected changes",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-i"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run backend tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify staged updates",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit repository updates",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Improve escrow validation and staging safety",
				"-m",
				"Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push repository updates",
			"type": "shell",
			"command": "git",
			"args": [
				"push"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage updated VS Code task configuration",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"--",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Git state",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review Git changes",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"git diff --stat; git diff --cached --stat; git diff -- .vscode/settings.json .vscode/tasks.json; git diff --cached -- .vscode/settings.json .vscode/tasks.json; git --no-pager log -4 --oneline --decorate; git remote -v"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}