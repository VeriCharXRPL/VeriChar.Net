# Local development defaults. Keep this file private and out of Git.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
API_TOKENS_JSON=[]
API_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Fill in with your local PostgreSQL connection URL before running migrations.
DATABASE_URL=
