# Testnet only. Never put mainnet seeds here.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# API bearer credentials. Store only SHA-256 hashes of random, high-entropy
# tokens here. Each record is bound to one tenant and an explicit scope list.
# Generate a token with: openssl rand -hex 32
# Hash it with: printf %s 'TOKEN' | sha256sum
# Replace this example with a JSON array containing the hash, tenant ID, scopes:
# API_TOKENS_JSON=[{"keyHash":"<64-character-sha256-hex>","tenantId":"example-tenant","scopes":["tenant:read","ledger:read"]}]
API_TOKENS_JSON=[]

# Origins permitted to read the public health endpoint from a browser.
# Exact HTTPS origins only. HTTP allowed only for localhost development.
# Production (Vercel + custom domain) — paste this exact value on Render:
# API_CORS_ORIGINS=["https://verichar.net","https://www.verichar.net","https://verichar.vercel.app"]
# Local development:
# API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_CORS_ORIGINS=[]

# Render sets PORT automatically. Local default is 3000.
PORT=3000

# Optional: fixed wallets for integration tests (funded on testnet faucet).
# Leave empty to fund ephemeral wallets from the faucet in tests.
# DONOR_SEED=
# VENDOR_ADDRESS=
# ORACLE_SEED=

# Never commit the real .env. Fulfillment secrets are not stored in env;
# they are generated per escrow and held only by the oracle process in memory / secure store.
